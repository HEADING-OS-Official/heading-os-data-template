# HEADING OS private data repository: gitignore

# Rebuildable associative-memory index (regenerated by memory-index.py).
.memory-index/
.memory-index-code/

# Secrets and runtime credentials: NEVER commit these.
.env
.env.*
!.env.example
.sessions/
*.session
cookies.json

# Local runtime state.
.data/
.state/
.logs/
.sync/

# The runtime store, one folder per service (scripts/utils/runtime_dir.py), at
# the `runtime_store:` the engine's default registry names (`runtime-junk`; a
# registry that names another store needs these rules moved with it).
# A path is ignored on one of two bases, and each rule names its own:
#   durability: it is rebuildable or transient;
#   content: it carries text that must never enter history, such as mail not
#   yet approved for sending.
# state/ and logs/ are otherwise tracked: a queue, a cursor or an audit trail is
# durable operational state, and losing it loses an instruction or a trail.
# basis: durability.
/runtime-junk/*/cache/
/runtime-junk/*/tmp/
/runtime-junk/**/*.lock
/runtime-junk/**/*.tmp

# Lock and atomic-write sidecars beside hand-set machine state.
# basis: durability (a lock restores itself on first use).
/system/state/**/*.lock
/system/state/**/*.tmp

# Action Queue cards the operator has not approved carry the recipient, the
# subject and the whole drafted body, and a backup commits with `git add -A`,
# so un-sent mail would enter permanent history. Failed sends are kept whole in
# dead-letter/ for the same reason.
# basis: content.
/runtime-junk/action-queue/state/action-queue/queue.json
/runtime-junk/action-queue/state/action-queue/disposition-log.jsonl
/runtime-junk/*/state/dead-letter/
# Email fetch state: per-machine Exchange message ids, and run-*.json carries
# raw email bodies.
# basis: content.
/runtime-junk/email-intel/state/

# Per-machine daemon trails: one line per outbound mail (recipient and subject),
# the record of every write into this repository, and logs carrying message
# metadata from the channels a daemon watches.
# basis: content.
/runtime-junk/sync-exchange/logs/
/runtime-junk/overlay-guard/logs/
/runtime-junk/fireside/logs/
/runtime-junk/sentinel/logs/

# Quarantined wrecks at every depth. A reader that finds a state file unreadable
# moves it aside, so the wreck inherits the live file's content, draft bodies
# and recipients included.
# basis: content.
**/.quarantine/

# The handoff pointer is a copy of the newest handoff, rewritten on every
# compact, and carries the operator's own prompt text; the archive itself is
# the record and stays tracked.
# basis: content.
/runtime-junk/handoff/state/.latest/

# Scratch left at the addresses older layouts used.
# basis: durability.
/runtime-junk/_orphans/outputs/_tmp/
/runtime-junk/_orphans/outputs/browser/chrome-profile/
/runtime-junk/_orphans/outputs/clipboard/
/runtime-junk/_orphans/.tmp/
/runtime-junk/_orphans/outputs/operations/implement/_tmp/
/runtime-junk/_orphans/outputs/operations/email-intelligence/_extracted-threads.txt
/runtime-junk/_orphans/outputs/operations/zoom-cleanup/.profile/
/runtime-junk/_orphans/.pytest_cache/
__pycache__/
*.pyc
.DS_Store
